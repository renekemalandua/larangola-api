<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: 'Inter', Arial, sans-serif; background-color: #f6f9fc; margin: 0; padding: 20px; color: #333; }
    .container { max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    .header { background-color: #ffffff; padding: 24px; text-align: center; border-bottom: 1px solid #e2e8f0; }
    .header h1 { color: #1a365d; margin: 0; font-size: 24px; }
    .content { padding: 32px; line-height: 1.6; }
    .footer { background-color: #f8fafc; padding: 20px; text-align: center; font-size: 12px; color: #64748b; border-top: 1px solid #e2e8f0; }
    .btn { display: inline-block; padding: 12px 24px; background-color: #2563eb; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: bold; margin-top: 16px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      {{#if logoUrl}}
        <img src="{{logoUrl}}" alt="LarAngola" style="max-height: 50px; display: block; margin: 0 auto;">
      {{else}}
        <h1>LarAngola</h1>
      {{/if}}
    </div>
    <div class="content">
      <h2 style="color: #1e293b; margin-top: 0;">{{title}}</h2>
      {{{body}}}
    </div>
    <div class="footer">
      &copy; {{year}} LarAngola. Todos os direitos reservados.<br>
      Este é um email automático, por favor não responda.
    </div>
  </div>
</body>
</html>
